<?xml version="1.0" encoding="utf-8"?>
<!-- No location, maps or internet permissions: the app works entirely on-device. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartPantry">

        <!-- Screen 1: Pantry List (launcher) -->
        <activity
            android:name=".UI.MainActivity"
            android:exported="true"
            android:label="@string/title_pantry">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Screen 2: Add / Edit Ingredient -->
        <activity
            android:name=".UI.AddEditIngredientActivity"
            android:exported="false"
            android:parentActivityName=".UI.MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Screen 3: Suggested Recipes -->
        <activity
            android:name=".UI.SuggestedRecipesActivity"
            android:exported="false"
            android:label="@string/title_suggested" />

        <!-- Screen 4: Recipe Detail -->
        <activity
            android:name=".UI.RecipeDetailActivity"
            android:exported="false"
            android:parentActivityName=".UI.SuggestedRecipesActivity" />

        <!-- Screen 5: Settings -->
        <activity
            android:name=".UI.SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings" />
    </application>

</manifest>
